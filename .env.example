# Kopier til .env og fyll inn det du trenger. Uten .env starter appen i testmodus
# med standardverdiene nedenfor.

# API-nøkkel fra Anthropic. Uten nøkkel er testmodus alltid på.
ANTHROPIC_API_KEY=

# Modellen som brukes når testmodus er av.
KI_MODELL=claude-sonnet-5-5

# 1/true/yes/on slår testmodus på selv om nøkkelen er satt. Tom eller 0 gir ekte
# KI-kall når ANTHROPIC_API_KEY er satt.
TESTMODUS=

# Tom verdi gir en fast utviklingsnøkkel som er usikker.
SECRET_KEY=

DEBUG=True

# Kommaseparert. Legg til maskinens IP-adresse for å teste fra mobil på samme nett.
ALLOWED_HOSTS=localhost,127.0.0.1
